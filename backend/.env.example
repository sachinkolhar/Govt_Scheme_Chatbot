# Copy this file to backend/.env and update values.

# JWT secret used to sign access tokens
JWT_SECRET=change-this-in-production

# Groq API configuration
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# Chat retrieval and evidence selection
SEMANTIC_RETRIEVAL_TOP_K=20
CHAT_TOP_N=20
CHAT_FINAL_K=5
FAISS_MAX_DISTANCE=
CONFIDENCE_HIGH_THRESHOLD=0.75
CONFIDENCE_MEDIUM_THRESHOLD=0.45
RANK_WEIGHT_SEMANTIC=0.7
RANK_WEIGHT_ELIGIBILITY=0.2
RANK_WEIGHT_INTENT=0.1
BM25_ENABLED=true
RERANKER_ENABLED=true
CONVERSATION_TTL_SECONDS=3600

# External fallback; specify exact trusted roots, comma separated.
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
WEB_PAGE_FETCH_TIMEOUT_SECONDS=3
WEB_SEARCH_ALLOWED_DOMAINS=india.gov.in,mygov.in,myscheme.gov.in,pmkisan.gov.in,scholarships.gov.in,nic.in

# PostgreSQL connection string (recommended)
# Format: postgresql+psycopg2://username:password@host:port/database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/govt_schemes
